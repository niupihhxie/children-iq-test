.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.page-header {
  padding: 40rpx 30rpx 20rpx;
}

/* 档案列表 */
.profile-list {
  padding: 20rpx 30rpx;
}
.profile-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  transition: all 0.2s;
}
.profile-card:active {
  transform: scale(0.98);
}
.profile-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #FFF5E6;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.avatar-emoji {
  font-size: 56rpx;
}
.profile-info {
  flex: 1;
}
.profile-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}
.profile-detail {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}
.profile-action {
  padding: 10rpx 20rpx;
}
.action-text {
  font-size: 28rpx;
  color: #FF9500;
  font-weight: 600;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
}
.empty-emoji {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}
.empty-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #666;
}
.empty-sub {
  font-size: 28rpx;
  color: #aaa;
  margin-top: 12rpx;
}

/* 添加按钮 */
.add-btn-area {
  padding: 40rpx 60rpx;
}
.btn-large {
  width: 100%;
  font-size: 36rpx;
  padding: 26rpx 0;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.modal-content {
  background: #fff;
  border-radius: 32rpx;
  width: 88%;
  max-width: 640rpx;
  padding: 40rpx;
}
.modal-title {
  font-size: 38rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 30rpx;
}
.form-label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}
.form-input {
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  background: #fafafa;
}
.picker-text {
  color: #333;
}

.gender-picker {
  display: flex;
  gap: 20rpx;
}
.gender-option {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  font-size: 30rpx;
  background: #fafafa;
}
.gender-option.active {
  border-color: #FF9500;
  background: #FFF5E6;
  color: #FF9500;
  font-weight: 600;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}
.modal-btn {
  flex: 1;
  font-size: 32rpx;
  padding: 20rpx 0;
}

.delete-btn {
  text-align: center;
  margin-top: 30rpx;
  font-size: 28rpx;
  color: #FF6B6B;
  padding: 16rpx;
}
