.container { min-height: 100vh; padding-bottom: 40rpx; }

.child-selector {
  padding: 20rpx 0;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.child-scroll { white-space: nowrap; padding: 0 20rpx; }
.child-chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #666;
}
.child-chip.active {
  background: #FF9500;
  color: #fff;
  font-weight: 600;
}

.chart-card {
  background: #fff;
  border-radius: 24rpx;
  margin: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
}
.trend-canvas { width: 100%; height: 400rpx; }

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
  justify-content: center;
}
.legend-item { display: flex; align-items: center; }
.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 6rpx;
}
.legend-text { font-size: 24rpx; color: #666; }

/* 统计卡片 */
.stats-card { margin: 0 24rpx 24rpx; }
.stats-grid {
  display: flex;
  flex-wrap: wrap;
}
.stat-item {
  width: 50%;
  text-align: center;
  padding: 20rpx;
}
.stat-num {
  font-size: 48rpx;
  font-weight: 900;
  color: #FF9500;
}
.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 维度变化 */
.dim-trend-card { margin: 0 24rpx 24rpx; }
.dim-trend-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}
.dim-trend-item:last-child { border-bottom: none; }
.dim-trend-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.dim-trend-header text:first-child {
  font-size: 30rpx;
  font-weight: 700;
}
.trend-change {
  font-size: 26rpx;
  font-weight: 600;
  color: #999;
}
.trend-change.up { color: #4ECDC4; }
.trend-change.down { color: #FF6B6B; }
.dim-trend-values {
  display: flex;
  gap: 16rpx;
  font-size: 26rpx;
  color: #999;
}
.trend-arrow { color: #ccc; }

.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}
.empty-emoji { font-size: 120rpx; margin-bottom: 30rpx; }
.empty-text { font-size: 36rpx; font-weight: 600; color: #666; }
.empty-sub { font-size: 28rpx; color: #aaa; margin-top: 12rpx; }
