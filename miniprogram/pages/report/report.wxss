.report-container {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 智力类型卡片 */
.type-card {
  background: linear-gradient(135deg, #FF9500 0%, #FFB347 50%, #FFCC80 100%);
  text-align: center;
  padding: 50rpx 30rpx 40rpx;
  border-radius: 0 0 40rpx 40rpx;
}
.type-emoji {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.type-name {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}
.type-tag {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 8rpx;
}
.total-score {
  margin-top: 30rpx;
}
.score-num {
  font-size: 80rpx;
  font-weight: 900;
  color: #fff;
}
.score-unit {
  font-size: 32rpx;
  color: rgba(255,255,255,0.8);
  margin-left: 8rpx;
}
.score-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 4rpx;
}

/* 图表卡片 */
.chart-card {
  background: #fff;
  border-radius: 24rpx;
  margin: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
}
.radar-canvas {
  width: 100%;
  height: 500rpx;
}

/* 维度分数列表 */
.dim-scores {
  margin-top: 20rpx;
}
.dim-score-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.dim-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.dim-info {
  width: 200rpx;
  flex-shrink: 0;
}
.dim-name {
  font-size: 28rpx;
  color: #555;
}
.dim-val {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  margin-left: 8rpx;
}
.dim-bar-wrap {
  flex: 1;
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}
.dim-bar {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

/* 详细分析 */
.detail-card {
  margin: 0 24rpx 24rpx;
}
.dim-detail {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}
.dim-detail:last-child {
  border-bottom: none;
}
.dim-detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.dim-detail-name {
  font-size: 32rpx;
  font-weight: 700;
}
.dim-detail-score {
  font-size: 34rpx;
  font-weight: 800;
  color: #FF9500;
}
.dim-detail-stats {
  display: flex;
  gap: 30rpx;
  font-size: 26rpx;
  color: #999;
}

/* 建议 */
.suggestion-card {
  margin: 0 24rpx 24rpx;
}
.suggestion-item {
  margin-bottom: 24rpx;
}
.suggestion-type {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  display: inline-block;
}
.suggestion-type.advantage {
  background: #E8F8F7;
  color: #4ECDC4;
}
.suggestion-type.improve {
  background: #FFF5E6;
  color: #FF9500;
}
.suggestion-type.general {
  background: #F0F0FF;
  color: #666;
}
.suggestion-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
  padding-left: 8rpx;
}

/* 操作按钮 */
.action-area {
  padding: 20rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.btn-action {
  width: 100%;
  font-size: 34rpx;
  padding: 22rpx 0;
}

.footer-tip {
  text-align: center;
  padding: 20rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}
.loading-emoji {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  animation: bounce 1s infinite;
}
.loading-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #666;
}
@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}
